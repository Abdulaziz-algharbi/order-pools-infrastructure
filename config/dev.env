# Dev-environment values, sourced after config/common.env. Anything set
# here overrides/extends the shared config for this environment only.
#
# AWS_ACCOUNT_ID is deliberately NOT here — see lib/aws-guard.sh's
# check_account_region() for why: it's pinned into a gitignored
# config/dev.local.env on this environment's first successful run
# instead of ever being hardcoded in a committed file.

ENVIRONMENT="dev"
AWS_REGION="eu-north-1"

# --- Networking -----------------------------------------------------
# A /16 gives 65,536 addresses — far more than this project needs, but
# VPC CIDR is essentially free to over-provision and expensive/disruptive
# to resize later, so starting big is the conventional default.
VPC_CIDR="10.20.0.0/16"

# Both subnets are PUBLIC. Per the decision to skip a NAT Gateway, the
# ALB and the backend EC2 instance share this pair, one subnet per AZ —
# there are no private subnets in this design at all.
PUBLIC_SUBNET_CIDRS=("10.20.0.0/24" "10.20.1.0/24")

# --- Backend compute --------------------------------------------------
INSTANCE_TYPE="t3.small"
BACKEND_PORT="8000"

# Keep in sync with order-pools-backend/Dockerfile (currently
# `node:26-alpine`) and that repo's local `node -v`. This can't be
# auto-detected from here: infrastructure/ is deliberately a separate
# repo, and a GitHub Actions runner building this repo won't have a
# checkout of order-pools-backend to inspect.
NODE_MAJOR_VERSION="26"

# --- DNS (used from Phase 3 onward) -----------------------------------
DOMAIN_ROOT="aziz-g.click"
BACKEND_DOMAIN="dev-api.aziz-g.click"
FRONTEND_DOMAIN="dev-app.aziz-g.click"

# --- Email: AWS SES (email/01-ses.sh) ---------------------------------
# The domain identity is verified once per account+region and is shared
# by every environment sending from it (see email/01-ses.sh on why
# destroy.sh deliberately leaves it in place). The From address and the
# SMTP IAM user are what's environment-specific.
SES_DOMAIN="aziz-g.click"
# Custom MAIL FROM (the envelope/bounce domain) — a dedicated subdomain,
# so its MX/SPF records never collide with anything else on the domain.
SES_MAIL_FROM_DOMAIN="mail.aziz-g.click"
# What users see in the From line. A no-reply address on our own domain,
# because that's what SES can DKIM-sign and DMARC-align — sending "from"
# a gmail.com address through SES fails Gmail's DMARC and lands in spam.
SES_FROM_ADDRESS="no-reply@aziz-g.click"
SES_FROM_NAME="Order Pool"
# Where replies go: a real, human-read inbox. Needs no SES verification —
# it's only a header telling mail clients where to send a reply.
SES_REPLY_TO="order.pool.mailer@gmail.com"

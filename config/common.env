# Sourced (not parsed — these are bash files, `source`d by every script,
# not dotenv files read by a library) by every script via `source`, right
# after lib/*.sh. Values here apply to every environment; anything
# environment-specific belongs in config/<env>.env instead.

PROJECT="order-pool"
TAG_MANAGED_BY="bash"

# Disables the AWS CLI's interactive output pager (`less`). Without this,
# any command whose output is long enough invokes a pager and hangs a
# non-interactive script — and every GitHub Actions run — forever,
# waiting for a 'q' keypress that will never come.
export AWS_PAGER=""

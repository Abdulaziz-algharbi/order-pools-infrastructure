# Copy this file to config/dev.secrets.env (gitignored — see .gitignore)
# and fill in real values. backend/env-to-ssm.sh reads dev.secrets.env
# and pushes every KEY=VALUE line here into SSM Parameter Store as a
# SecureString under /order-pool/dev/backend/<KEY>. That parameter path
# is exactly what iam/01-ec2-instance-role.sh already scoped the EC2
# instance role's read permission to — nothing else in this account is
# readable with that credential.
#
# Everything here maps 1:1 to order-pools-backend/.env.example — these
# ARE this project's production environment variables. All values are
# bundled into one SecureString-encrypted path for simplicity, even the
# few that aren't strictly secret (PORT, APP_MODE, FRONTEND_URL):
# splitting "secret" vs "config" into two separate stores would double
# the places deploy-backend.sh has to read from for no real security
# benefit, since the whole path is already access-controlled to just
# this instance's role.

PORT=8000
APP_MODE=PROD

# Atlas connection string, with the REAL password substituted for
# <db_password> (the value you shared has it redacted — that's correct,
# never paste the real password into a chat or a committed file).
# Unlike the local dev URI, no `replicaSet=`/`directConnection=` query
# params are needed here — an Atlas cluster (including the M0 free tier)
# is always a replica set and the mongodb+srv:// scheme already encodes
# everything the driver needs to find every node.
PROD_MONGO_URI=mongodb+srv://abdulazizalgharbi8_db_user:REPLACE_ME@cluster0.bvsdj3c.mongodb.net/order-pool?appName=Cluster0

# Must match dns-tls's BACKEND_DOMAIN counterpart on the frontend side —
# i.e. this is the frontend's own dev domain, not the backend's.
FRONTEND_URL=https://dev-app.aziz-g.click

JWT_TOKEN_SECRET=REPLACE_ME
JWT_REFRESH_TOKEN_SECRET=REPLACE_ME
JWT_TOKEN_TTL=1h
JWT_REFRESH_TOKEN_TTL=7d

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

THAWANI_SECRET_KEY=REPLACE_ME
THAWANI_PUBLISHABLE_KEY=REPLACE_ME
THAWANI_API_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_BASE_URL=https://uatcheckout.thawani.om

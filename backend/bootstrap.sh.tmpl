#!/bin/bash
# Runs ONCE, as root, on first boot (cloud-init "user data"). Placeholders
# like __PROJECT__ are substituted by backend/01-ec2-instance.sh before
# this is passed to `aws ec2 run-instances --user-data`.
#
# The backend runs as a Docker container (order-pools-backend/Dockerfile),
# so this instance needs no Node.js or npm at all: only the Docker Engine
# to run the image, and the AWS CLI + jq the deploy script uses to pull it
# and write its settings. The Node version lives in the image, not here.
set -Eeuo pipefail
exec > >(tee -a /var/log/order-pool-bootstrap.log) 2>&1
echo "=== order-pool bootstrap starting: $(date -u) ==="

APP_ROOT="/opt/__PROJECT__-backend"

echo "--- Installing Docker Engine and the Compose plugin from Docker's apt repository ---"
# Docker's own repository rather than Ubuntu's `docker.io` package: it's
# the install Docker documents and supports, it tracks current Engine
# releases, and it carries `docker-compose-plugin` (the `docker compose`
# subcommand the deploy uses). Packages are verified against Docker's
# GPG key, pinned to this one repository with `signed-by`. Fetched over
# 443 (download.docker.com); Ubuntu's own archives — for ca-certificates,
# curl and Docker's dependencies — over 80, as the security group allows.
apt-get update -y
apt-get install -y ca-certificates curl
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
# shellcheck source=/dev/null
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

echo "--- Configuring the Docker daemon ---"
# log-driver/log-opts: the DEFAULT for any container that doesn't choose
# its own. The backend's container sends its logs to CloudWatch (awslogs
# driver, set per container by the deploy); this default only covers
# anything else run here by hand (e.g. the one-off admin-seed container),
# and caps each such container's local log at 3 x 10 MB instead of
# Docker's default of unbounded — a small root disk can fill up.
# live-restore: containers keep running while the Docker daemon itself
# restarts (e.g. a Docker package upgrade), instead of all stopping with
# it.
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'EOF'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" },
  "live-restore": true
}
EOF
# enable: start on every boot, which is what brings the backend back up
# after a reboot — its container has `restart: unless-stopped`, so the
# daemon restarts it. This replaces the systemd unit the app used to
# have; systemd now only manages Docker itself.
systemctl enable docker
systemctl restart docker

# `set -e` already stops this script if an install fails outright. This
# catches the sneakier case of a binary on PATH that doesn't work — e.g.
# the daemon failing to start on the config above. Bootstrap must not
# report success then.
echo "--- Verifying the Docker install ---"
docker version || { echo "FATAL: docker version failed — is the daemon running?" >&2; exit 1; }
docker compose version || { echo "FATAL: docker compose version failed after install" >&2; exit 1; }

echo "--- Installing the AWS CLI v2 and jq ---"
# The SSM Agent (which lets `aws ssm send-command` reach this instance
# at all) is a separate, statically-compiled binary with no relation to
# the `aws` CLI tool — neither it nor Ubuntu's stock image includes the
# CLI. deploy-remote.sh.tmpl needs both `aws` (ecr get-login-password,
# ssm get-parameters-by-path) and `jq` (parsing that command's JSON
# output into .env lines) to run at all, so both are installed
# explicitly here rather than assumed present.
apt-get install -y unzip jq
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws
aws --version || { echo "FATAL: aws --version failed after install" >&2; exit 1; }
jq --version || { echo "FATAL: jq --version failed after install" >&2; exit 1; }

echo "--- Confirming the SSM Agent is running ---"
# Canonical's official Ubuntu AMIs (the ones this project resolves via
# the /aws/service/canonical/... SSM public parameter) ship the SSM
# Agent pre-installed as a snap. This is what lets `aws ssm
# send-command`/`start-session` reach the instance with zero inbound
# ports open — no SSH, no bastion host.
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || \
  echo "WARNING: could not enable the snap SSM agent service — check manually via the SSM console."

echo "--- Creating the app directory ---"
# Layout (filled in by deploy-remote.sh.tmpl, not here):
#   APP_ROOT/compose.yml    which image runs, its port, restart policy and
#                           log driver — rewritten on every deploy
#   APP_ROOT/shared/.env    settings and secrets pulled from SSM Parameter
#                           Store at deploy time, never baked into the
#                           image or this script
# Owned by root and closed to everyone else: only the Docker daemon
# (root) reads .env, to hand its values to the container. The app itself
# runs as the image's unprivileged `node` user, inside the container.
mkdir -p "${APP_ROOT}/shared"
chmod 700 "${APP_ROOT}" "${APP_ROOT}/shared"

echo "=== order-pool bootstrap complete: $(date -u) ==="
echo "Docker is running, but no backend container yet — the first deploy (deploy-backend.sh) pulls the image and starts it."

#!/bin/bash
# Runs ONCE, as root, on first boot (cloud-init "user data"). Placeholders
# like __NODE_MAJOR_VERSION__ are substituted by backend/01-ec2-instance.sh
# before this is passed to `aws ec2 run-instances --user-data`.
set -Eeuo pipefail
exec > >(tee -a /var/log/order-pool-bootstrap.log) 2>&1
echo "=== order-pool bootstrap starting: $(date -u) ==="

APP_USER="orderpool"
APP_ROOT="/opt/__PROJECT__-backend"
SERVICE_NAME="__PROJECT__-backend"
NODE_MAJOR_VERSION="__NODE_MAJOR_VERSION__"

echo "--- Installing Node.js ${NODE_MAJOR_VERSION}.x via NodeSource ---"
# NodeSource's setup script is the standard, reliable way to get a
# specific Node major version onto Ubuntu without building from source
# or relying on Ubuntu's own (often stale) distro package. The version
# comes from config/<env>.env's NODE_MAJOR_VERSION, kept in sync with
# order-pools-backend's own pinned Node version — not hardcoded here.
apt-get update -y
curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR_VERSION}.x" | bash -
apt-get install -y nodejs

# `set -e` already aborts this script the instant `apt-get install`
# returns non-zero, so a hard package-manager failure can't reach this
# point at all. This check is for the narrower, sneakier case: node/npm
# ending up on PATH but non-functional (a partial/corrupt install that
# still exits 0). Bootstrap must not report success in that case either.
echo "--- Verifying the Node.js install ---"
node --version || { echo "FATAL: node --version failed after install" >&2; exit 1; }
npm --version || { echo "FATAL: npm --version failed after install" >&2; exit 1; }

echo "--- Installing the AWS CLI v2 and jq ---"
# The SSM Agent (which lets `aws ssm send-command` reach this instance
# at all) is a separate, statically-compiled binary with no relation to
# the `aws` CLI tool — neither it nor Ubuntu's stock image includes the
# CLI. deploy-remote.sh.tmpl needs both `aws` (s3 cp, ssm
# get-parameters-by-path) and `jq` (parsing that command's JSON output
# into .env lines) to run at all, so both are installed explicitly here
# rather than assumed present.
apt-get install -y unzip jq
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/awscliv2.zip /tmp/aws
aws --version || { echo "FATAL: aws --version failed after install" >&2; exit 1; }
jq --version || { echo "FATAL: jq --version failed after install" >&2; exit 1; }

echo "--- Confirming the SSM Agent is running ---"
# Canonical's official Ubuntu AMIs (the ones this project resolves via
# the /aws/service/canonical/... SSM public parameter) ship the SSM
# Agent pre-installed as a snap. This is what lets `aws ssm
# send-command`/`start-session` reach the instance with zero inbound
# ports open — no SSH, no bastion host.
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || \
  echo "WARNING: could not enable the snap SSM agent service — check manually via the SSM console."

echo "--- Creating a dedicated, unprivileged app user and directories ---"
# The application must never run as root: a compromised Express process
# should only ever be able to touch its own release directory, nothing
# else on the box.
id -u "$APP_USER" >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin "$APP_USER"
mkdir -p "${APP_ROOT}/releases" "${APP_ROOT}/shared"
chown -R "${APP_USER}:${APP_USER}" "$APP_ROOT"

echo "--- Installing the systemd unit (not started yet — no release deployed) ---"
# Release layout (populated by Phase 3's deploy-backend.sh, not here):
#   APP_ROOT/releases/<timestamp>/   one directory per deployed build
#   APP_ROOT/current -> releases/<timestamp>   symlink, atomically
#                                               repointed on each deploy
#                                               (enables instant rollback
#                                               by repointing it back)
#   APP_ROOT/shared/.env             secrets pulled from SSM Parameter
#                                     Store at deploy time, never baked
#                                     into the release or this script
cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<EOF
[Unit]
Description=Order Pool backend (Express/TypeScript)
After=network.target

[Service]
Type=simple
User=${APP_USER}
WorkingDirectory=${APP_ROOT}/current
EnvironmentFile=${APP_ROOT}/shared/.env
ExecStart=/usr/bin/node ${APP_ROOT}/current/dist/src/server.js
Restart=on-failure
RestartSec=5
# order-pools-backend/src/server.ts only traps SIGINT to shut down
# gracefully (closes the HTTP server + Mongo connection cleanly before
# exiting) — it does not handle SIGTERM, systemd's default stop signal.
# Rather than changing application code for an infrastructure concern,
# systemd is told to send the signal the app already understands.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
echo "=== order-pool bootstrap complete: $(date -u) ==="
echo "${SERVICE_NAME} is installed but NOT enabled/started — run deploy-backend.sh (Phase 3) to ship a release and start it."
